# ── RPC endpoints ─────────────────────────────────────────────────────────────
ETH_RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY
BSC_RPC_URL=https://bsc-dataseed.binance.org/
POLYGON_RPC_URL=https://polygon-rpc.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
OPTIMISM_RPC_URL=https://mainnet.optimism.io
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
BASE_RPC_URL=https://mainnet.base.org

# ── Block-explorer API keys ────────────────────────────────────────────────────
ETHERSCAN_API_KEY=YOUR_KEY
BSCSCAN_API_KEY=YOUR_KEY
POLYGONSCAN_API_KEY=YOUR_KEY

# ── AI / LLM ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=YOUR_KEY
OPENAI_BASE_URL=https://api.openai.com/v1   # override for local models / OpenRouter

# ── Faucet / payment-wall SaaS ─────────────────────────────────────────────────
FAUCET_PRIVATE_KEY=0xYOUR_HOT_WALLET_PRIVATE_KEY
FAUCET_DRIP_AMOUNT=0.001
FAUCET_COOLDOWN_SECONDS=86400

PAYMENT_WALL_PRIVATE_KEY=0xYOUR_HOT_WALLET_PRIVATE_KEY
PAYMENT_WALL_SECRET=change_me_in_production

# ── Whale notifier ─────────────────────────────────────────────────────────────
WHALE_THRESHOLD_ETH=100
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_CHAT_ID

# ── Copy-trader ────────────────────────────────────────────────────────────────
COPY_TRADE_WALLET=0xTARGET_WALLET_TO_COPY
COPY_TRADE_PRIVATE_KEY=0xYOUR_EXECUTION_WALLET
